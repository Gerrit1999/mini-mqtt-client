{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-theme",
    "core:event:allow-listen",
    "opener:default",
    "dialog:default",
    "process:allow-restart",
    "updater:default",
    "fs:default",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DESKTOP/**/*",
        "$DOWNLOAD/**/*",
        "$DOCUMENT/**/*",
        "$HOME/**/*",
        "$TEMP/**/*"
      ]
    }
  ]
}
